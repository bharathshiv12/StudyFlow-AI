{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  
  // Environment configuration for Cloudflare Workers
  // Ensure Supabase credentials are available in CF edge runtime
  "env": {
    "production": {
      // Public variables available to both client and server
      "vars": {
        "VITE_SUPABASE_URL": "https://vwkxjnkdbupewezzosqc.supabase.co",
        "SUPABASE_URL": "https://vwkxjnkdbupewezzosqc.supabase.co"
      },
      // Secrets should be set via: wrangler secret put SUPABASE_PUBLISHABLE_KEY --env production
      "secrets": ["SUPABASE_PUBLISHABLE_KEY", "SUPABASE_SERVICE_ROLE_KEY"]
    },
    "development": {
      "vars": {
        "VITE_SUPABASE_URL": "https://vwkxjnkdbupewezzosqc.supabase.co",
        "SUPABASE_URL": "https://vwkxjnkdbupewezzosqc.supabase.co"
      }
    }
  },
  
  // Observability settings for debugging
  "observability": {
    "enabled": true
  }
}
